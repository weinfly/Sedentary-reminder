<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <appSettings>
    <!-- 工作时间（分钟） -->
    <add key="WorkTimeValue" value="90"/>
    <!-- 休息时间（分钟） -->
    <add key="RestTimeValue" value="30"/>
    
    <!-- 
      工作时间段配置，支持两种格式：
      
      格式1（简单，向后兼容）：使用 AutoStartHours 和 AutoStopHours
      例如：9,13 和 12,18 表示 9:00-12:00 和 13:00-18:00
      
      格式2（精确到分钟）：使用 WorkPeriods
      格式：开始小时:开始分钟-结束小时:结束分钟,用逗号分隔多个时间段
      例如：9:0-12:0,13:0-16:30 表示 9:00-12:00 和 13:00-16:30
    -->
    
    <!-- 简单格式（与原有配置兼容） -->
    <add key="AutoStartHours" value="9,13"/>
    <add key="AutoStopHours" value="12,18"/>
    
    <!-- 精确格式（优先使用此配置，注释掉则回退到简单格式） -->
    <!-- <add key="WorkPeriods" value="9:0-12:0,13:0-16:0"/> -->
    
    <!-- 客户端程序路径，默认为同目录下的 Reminder.exe -->
    <!-- <add key="ClientExePath" value="D:\YourPath\Reminder.exe"/> -->
  </appSettings>
</configuration>